# URL pública del sitio (sin / al final). En Vercel: https://clubdelamontana.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console: código de la etiqueta HTML (solo el valor de content="..."). Opcional.
GOOGLE_SITE_VERIFICATION=

# --- Firebase Admin (servidor) ---
# Consola Firebase > Configuración del proyecto > Cuentas de servicio > Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave con los \n tal cual vienen en el JSON, entre comillas
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Panel ---
# Clave con la que Sally entra a /admin
ADMIN_PASSWORD=
# Firma de la cookie de sesión: texto aleatorio de 32+ caracteres.
# Si lo cambias, se cierran todas las sesiones abiertas.
SESSION_SECRET=

# --- Flow (cuenta de Sally) ---
# flow.cl > Mis datos > Integración con API: apiKey y secretKey
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Producción: https://www.flow.cl/api · Pruebas: https://sandbox.flow.cl/api (con credenciales de sandbox.flow.cl)
FLOW_API_URL=https://www.flow.cl/api

# --- Correos (Resend) ---
# resend.com > API Keys. El dominio del remitente debe estar verificado en resend.com > Domains
RESEND_API_KEY=
EMAIL_FROM="Club de la Montaña <inscripciones@clubdelamontana.cl>"
# A quién le llega el aviso de cada inscripción
ADMIN_NOTIFY_EMAIL=

# --- Solo desarrollo local ---
# NEXT_PUBLIC_USE_EMULATORS=1 usa los emuladores de Firebase
# PAGO_SIMULADO=1 permite simular el pago sin Flow (nunca en producción)
