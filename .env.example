# URL pública del sitio (sin / al final). En Vercel: https://clubdelamontana.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase (cliente: solo se usa para el login del panel) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Firebase Admin (servidor) ---
# Consola Firebase > Configuración del proyecto > Cuentas de servicio > Generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la clave con los \n tal cual vienen en el JSON, entre comillas
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Correos que pueden entrar al panel (separados por coma)
ADMIN_EMAILS=

# --- Mercado Pago (cuenta de Sally) ---
# Tus integraciones > Credenciales de producción > Access token
MP_ACCESS_TOKEN=
# Tus integraciones > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=

# --- Correos (SMTP). Con Gmail: smtp.gmail.com, 465, y una "contraseña de aplicación" ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Club de la Montaña <correo@ejemplo.cl>"
# A quién le llega el aviso de cada inscripción
ADMIN_NOTIFY_EMAIL=

# --- Solo desarrollo local ---
# NEXT_PUBLIC_USE_EMULATORS=1 usa los emuladores de Firebase
# PAGO_SIMULADO=1 permite simular el pago sin Mercado Pago (nunca en producción)
